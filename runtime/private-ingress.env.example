# Copy to runtime/private-ingress.env (ignored). Never commit a real auth key.
TS_AUTHKEY=
# Stable tag is mutable; pin a tested version/digest before operational deployment.
TAILSCALE_IMAGE=tailscale/tailscale:stable
# Starts empty. When Relay activation is approved, set only the private Relay ->
# Gateway write-key registry here; do not put the Browser -> Relay key in this file.
PRIVATE_GATEWAY_RELAY_BROWSER_KEYS_JSON={}
# Keep empty until private health has been verified from the Medusa host.
PRIVATE_GATEWAY_BACKEND_KEYS_JSON={}
