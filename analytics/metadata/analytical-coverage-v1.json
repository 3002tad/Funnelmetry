{
  "catalog_id": "funnelmetry-analytical-coverage",
  "version": "1.0.0",
  "status": "DRAFT_COVERAGE",
  "runtime_published": false,
  "scope": "current-v2-analytical-data-and-opt-in-staging-assets",
  "description": "Inventory of analytical meanings and physical bindings, not a grant for AI to query every relation.",
  "assets": [
    {
      "id": "asset.canonical_event",
      "description": "One stored canonical row; not necessarily one distinct source event or customer.",
      "relation": "public.canonical_events",
      "schema_ref": "infra/postgres/v2/001_canonical_ledger.sql",
      "grain": ["canonical_event_id"],
      "primary_keys": ["canonical_event_id"],
      "time_basis": "occurred_at",
      "authority": "Versioned canonical mapping of source events; business authority depends on event_class and quality.",
      "required_columns": {"canonical_event_id": "text", "source_id": "text", "source_event_id": "text", "event_type": "text", "event_class": "text", "mapping_version": "text", "occurred_at": "timestamp with time zone", "quality": "jsonb"},
      "dimensions": ["source_id", "event_type", "event_class"],
      "measures": [{"id": "measure.stored_canonical_row_count", "aggregation": "count_rows", "unit": "rows"}],
      "relationships": [],
      "quality_requirements": ["Event time may be a fallback; do not claim source occurrence or delivery completeness from row counts."],
      "supported_operations": ["event_counts"],
      "tool_refs": ["event_counts"],
      "limitations": ["No unique-customer, payment, or complete-source-history claim."],
      "availability": "IMPLEMENTED_OPT_IN"
    },
    {
      "id": "asset.journey",
      "description": "One progressively linked journey; a session is not a journey or a unique person.",
      "relation": "public.journeys",
      "schema_ref": "infra/postgres/v2/002_journey_projection.sql",
      "grain": ["journey_id"],
      "primary_keys": ["journey_id"],
      "time_basis": "first_event_at",
      "authority": "Pipeline identity/journey projection, not a source customer registry.",
      "required_columns": {"journey_id": "text", "source_id": "text", "status": "text", "first_event_at": "timestamp with time zone", "last_event_at": "timestamp with time zone", "event_count": "bigint"},
      "dimensions": ["source_id", "status"],
      "measures": [{"id": "measure.journey_event_count", "field": "event_count", "aggregation": "none", "unit": "events_in_journey"}],
      "relationships": [],
      "quality_requirements": ["Identity evidence must be checked before cross-session/customer claims."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["No retention or unique-customer metric without a separate identity/history contract."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.journey_event",
      "description": "Canonical event linked to one journey with a recorded confidence category.",
      "relation": "public.journey_events",
      "schema_ref": "infra/postgres/v2/002_journey_projection.sql",
      "grain": ["canonical_event_id"],
      "primary_keys": ["canonical_event_id"],
      "time_basis": "occurred_at",
      "authority": "Pipeline journey linkage; weak or isolated links are not confirmed customer identity.",
      "required_columns": {"canonical_event_id": "text", "journey_id": "text", "event_type": "text", "occurred_at": "timestamp with time zone", "link_confidence": "text"},
      "dimensions": ["event_type", "link_confidence"],
      "measures": [],
      "relationships": [{"target_asset": "asset.journey", "keys": ["journey_id"], "cardinality": "many-to-one", "safe_aggregation": false}],
      "quality_requirements": ["Do not merge separate journeys from session context alone."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["No exposed path/journey semantic tool yet."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.funnel_instance",
      "description": "One entry into a versioned funnel profile; a journey may have multiple instances.",
      "relation": "public.funnel_instances",
      "schema_ref": "infra/postgres/v2/003_funnel_projection.sql",
      "grain": ["funnel_instance_id"],
      "primary_keys": ["funnel_instance_id"],
      "time_basis": "entry_at",
      "authority": "Versioned funnel projection, not the source checkout state.",
      "required_columns": {"funnel_instance_id": "text", "source_id": "text", "journey_id": "text", "funnel_profile_id": "text", "profile_version": "text", "entry_at": "timestamp with time zone", "outcome_status": "text", "quality_status": "text"},
      "dimensions": ["source_id", "funnel_profile_id", "profile_version", "outcome_status", "quality_status"],
      "measures": [],
      "relationships": [{"target_asset": "asset.journey", "keys": ["journey_id"], "cardinality": "many-to-one", "safe_aggregation": false}],
      "quality_requirements": ["Observed/pending are not finalized conversion or drop-off."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["Use profile version and maturity policy for final-outcome claims."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.funnel_kpi_instance",
      "description": "One materialized KPI state per funnel instance, including observed and quality states.",
      "relation": "public.funnel_kpi_instance_facts",
      "schema_ref": "infra/postgres/v2/004_kpi_projection.sql",
      "grain": ["funnel_instance_id"],
      "primary_keys": ["funnel_instance_id"],
      "time_basis": "entry_at",
      "authority": "Pipeline observed funnel/KPI projection with separate maturity and reconciliation gates.",
      "required_columns": {"funnel_instance_id": "text", "source_id": "text", "funnel_profile_id": "text", "profile_version": "text", "entry_at": "timestamp with time zone", "outcome_status": "text", "quality_status": "text", "reached_step_count": "integer"},
      "dimensions": ["source_id", "funnel_profile_id", "profile_version", "outcome_status", "quality_status"],
      "measures": [{"id": "measure.funnel_entrant_count", "aggregation": "count_rows", "unit": "funnel_instances"}],
      "relationships": [],
      "quality_requirements": ["Observed cohort is not final; inspect maturity/reconciliation before authoritative claims."],
      "supported_operations": ["overview_observed"],
      "tool_refs": ["overview"],
      "limitations": ["No universal final conversion rate from observed counts."],
      "availability": "IMPLEMENTED_OPT_IN"
    },
    {
      "id": "asset.funnel_kpi_step",
      "description": "One reached step per funnel instance and step index.",
      "relation": "public.funnel_kpi_step_facts",
      "schema_ref": "infra/postgres/v2/004_kpi_projection.sql",
      "grain": ["funnel_instance_id", "step_index"],
      "primary_keys": ["funnel_instance_id", "step_index"],
      "time_basis": "first_reached_at",
      "authority": "Pipeline observed funnel-step projection.",
      "required_columns": {"funnel_instance_id": "text", "step_index": "integer", "step_id": "text", "event_type": "text", "first_reached_at": "timestamp with time zone", "occurrence_count": "bigint"},
      "dimensions": ["step_id", "event_type"],
      "measures": [{"id": "measure.step_occurrence_count", "field": "occurrence_count", "aggregation": "sum", "unit": "observed_occurrences"}],
      "relationships": [{"target_asset": "asset.funnel_kpi_instance", "keys": ["funnel_instance_id"], "cardinality": "many-to-one", "safe_aggregation": false}],
      "quality_requirements": ["One-to-many join must not duplicate entrant/order measures."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["Step rows alone do not establish eligible final drop-off."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.funnel_maturity_finalization",
      "description": "Immutable evidence that one in-progress funnel instance was finalized as dropped.",
      "relation": "public.funnel_maturity_finalizations",
      "schema_ref": "infra/postgres/v2/007_maturity_finalization.sql",
      "grain": ["finalization_id"],
      "primary_keys": ["finalization_id"],
      "time_basis": "finalized_at",
      "authority": "Maturity scheduler finalization evidence after versioned horizon/grace policy.",
      "required_columns": {"finalization_id": "text", "funnel_instance_id": "text", "source_id": "text", "finalized_outcome_status": "text", "finalized_at": "timestamp with time zone"},
      "dimensions": ["source_id", "finalized_outcome_status"],
      "measures": [],
      "relationships": [{"target_asset": "asset.funnel_instance", "keys": ["funnel_instance_id"], "cardinality": "one-to-one", "safe_aggregation": true}],
      "quality_requirements": ["Finalization is only valid under its published funnel time policy."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["Late conversion is recorded separately and does not rewrite official final outcome."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.funnel_late_conversion",
      "description": "Immutable record of a strongly linked conversion arriving after funnel finalization.",
      "relation": "public.funnel_late_conversions",
      "schema_ref": "infra/postgres/v2/008_late_conversion.sql",
      "grain": ["late_conversion_id"],
      "primary_keys": ["late_conversion_id"],
      "time_basis": "conversion_occurred_at",
      "authority": "Post-finalization business-fact evidence; not an official rewrite of a dropped outcome.",
      "required_columns": {"late_conversion_id": "text", "funnel_instance_id": "text", "source_id": "text", "arrival_class": "text", "conversion_occurred_at": "timestamp with time zone", "official_outcome_status": "text"},
      "dimensions": ["source_id", "arrival_class"],
      "measures": [],
      "relationships": [{"target_asset": "asset.funnel_instance", "keys": ["funnel_instance_id"], "cardinality": "one-to-one", "safe_aggregation": true}],
      "quality_requirements": ["Strong business-entity link and authoritative event time required."],
      "supported_operations": [],
      "tool_refs": [],
      "limitations": ["Do not silently revise previously finalized KPI."],
      "availability": "DOCUMENTED_ONLY"
    },
    {
      "id": "asset.fact_order",
      "description": "One Medusa placed order at source/order grain; not a payment receipt.",
      "relation": "public.analytical_fact_order_v1",
      "schema_ref": "analytics/sql/fact-order-v1.sql",
      "definition": {
        "status": "DRAFT",
        "version": "1.0.0",
        "runtime_published": false,
        "asset": {
          "id": "asset.fact_order",
          "relation": "analytical_fact_order_v1",
          "grain": ["source_id", "order_id"],
          "time_basis": "order_placed_at",
          "authority": "order.placed / BUSINESS_FACT / medusa-order-placed-v2",
          "quality_field": "quality_state",
          "required_quality": "VALID",
          "scope": "medusa-reference"
        },
        "measures": [
          {"id": "measure.gross_order_value", "field": "total_amount", "aggregation": "sum", "unit": "major_currency"},
          {"id": "measure.order_count", "fields": ["source_id", "order_id"], "aggregation": "count_distinct_tuple", "unit": "order"}
        ],
        "dimensions": [{"id": "dimension.currency_code", "field": "currency_code"}],
        "metrics": [{"id": "metric.average_order_value", "numerator": "measure.gross_order_value", "denominator": "measure.order_count", "zero_denominator": "null"}],
        "policies": {
          "cross_currency": "prohibited_without_fx_contract; group_by_currency_required",
          "blocked_rows": "block_execution_for_affected_scope; never_silently_drop",
          "tax_shipping_discount": "preserve_source_medusa.order.total; no_recalculation",
          "cancellation_refund": "no_subtraction_without_separate_lifecycle_contract",
          "item_allocation": "prohibited",
          "catalog_price_reconstruction": "prohibited",
          "measure.revenue": "unavailable_for_this_baseline; not_an_alias",
          "paid_captured_net_revenue": "unsupported"
        }
      },
      "grain": ["source_id", "order_id"],
      "primary_keys": ["source_id", "order_id"],
      "time_basis": "order_placed_at",
      "authority": "order.placed BUSINESS_FACT from medusa-order-placed-v2 mapping.",
      "required_columns": {"source_id": "text", "order_id": "text", "total_amount": "numeric", "currency_code": "text", "order_placed_at": "timestamp with time zone", "quality_state": "text"},
      "dimensions": ["source_id", "currency_code"],
      "measures": [{"id": "measure.gross_order_value", "field": "total_amount", "aggregation": "sum", "unit": "major_currency"}, {"id": "measure.order_count", "aggregation": "count_rows_at_order_grain", "unit": "orders"}],
      "relationships": [],
      "quality_requirements": ["Block invalid/conflicting source order facts; group currencies separately."],
      "supported_operations": ["metric_summary", "order_ranking"],
      "tool_refs": ["tool.metric_summary", "tool.order_ranking"],
      "limitations": ["Not paid/captured/net revenue; no item/category allocation of total order value."],
      "availability": "STAGED_TOOL"
    },
    {
      "id": "asset.ordered_product_item",
      "description": "One ordered item position; product ranking sums historical unit price times quantity.",
      "relation": "public.analytical_product_order_items_v1",
      "schema_ref": "analytics/sql/product-value-v1.sql",
      "definition": {
        "status": "DRAFT",
        "version": "1.0.0",
        "runtime_published": false,
        "tool_id": "tool.product_value_ranking",
        "catalog_release": "product-value-staging-1.0.0",
        "binding": "public.analytical_product_order_items_v1",
        "input_grain": ["source_id", "order_id", "item_position"],
        "output_grain": ["source_id", "currency_code", "product_id"],
        "time_basis": "order_placed_at",
        "value_refs": ["measure.ordered_product_unit_value@1.0.0"],
        "dimension_refs": ["dimension.currency_code@1.0.0", "dimension.product_id@1.0.0"],
        "formula": "SUM(point_in_time_unit_price_amount * quantity)",
        "limit_per_currency": 5,
        "policies": {
          "currency": "separate; no FX conversion",
          "money": "PostgreSQL numeric; major currency units; never JS arithmetic",
          "tax_shipping_discount": "no additional allocation or adjustment; source unit-price inclusion policy unverified",
          "revenue": "not paid/net revenue and not allocated order total",
          "refund_cancellation": "no deduction without separate lifecycle contract",
          "catalog": "current names only; never current prices",
          "quality": "block if any source order or items invalid; no silent exclusion",
          "deduplication": "one order once; conflicting ordered item arrays block"
        }
      },
      "grain": ["source_id", "order_id", "item_position"],
      "primary_keys": ["source_id", "order_id", "item_position"],
      "time_basis": "order_placed_at",
      "authority": "Item array from authoritative placed-order fact, not current catalog price.",
      "required_columns": {"source_id": "text", "order_id": "text", "item_position": "bigint", "product_id": "text", "quantity": "numeric", "ordered_product_unit_value": "numeric", "currency_code": "text", "order_placed_at": "timestamp with time zone", "quality_state": "text"},
      "dimensions": ["source_id", "product_id", "currency_code"],
      "measures": [{"id": "measure.ordered_product_unit_value", "field": "ordered_product_unit_value", "aggregation": "sum", "unit": "major_currency"}],
      "relationships": [{"target_asset": "asset.fact_order", "keys": ["source_id", "order_id"], "cardinality": "many-to-one", "safe_aggregation": false}],
      "quality_requirements": ["Block conflicting/invalid item arrays and invalid source orders; separate currencies."],
      "supported_operations": ["product_value_ranking"],
      "tool_refs": ["tool.product_value_ranking"],
      "limitations": ["Item-unit-price proxy is not paid revenue or allocated order total; current catalog title only."],
      "availability": "STAGED_TOOL"
    },
