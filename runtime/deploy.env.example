# One ignored env per isolated deployment. SWARM_* is the deployment path for
# NEW demo/dev stacks; follow docs/SWARM_MIGRATION.md. The currently verified
# candidate on the development machine is OFFLINE_DEMO with local HTTPS; another
# machine still needs its own hostname/certificate. Live Medusa feed is not enabled.
# Most HANDOFF_* entries below are retained for DEC-125 Compose rollback only;
# the Swarm launcher reuses HANDOFF_RAW_PARTITIONS and uses the separate
# SWARM_NORMALIZER_ID_MODE below. Do not reuse
# volumes or another machine's secrets. Never run both writers on shared state.
HANDOFF_PROJECT=funnelmetry-unified
HANDOFF_UI_PORT=5181
# LEGACY COMPOSE ROLLBACK ONLY: optional profiles for `runtime/deploy.mjs start`.
# Keep empty for core-only. On a fresh, isolated host after review, use:
# HANDOFF_DEPLOY_PROFILES=live,catalog,monitoring
HANDOFF_DEPLOY_PROFILES=

# Development/full-tool demo: build from this source using local image tags.
# For image-only deployment change policy to always and pin NEW verified image
# digests built from this version; old 2026-10-10 API digest lacks Polars.
HANDOFF_IMAGE_POLICY=build
HANDOFF_API_IMAGE=funnelmetry/unified-api:local
HANDOFF_WEB_IMAGE=funnelmetry/unified-web:local
HANDOFF_WORKERS_IMAGE=funnelmetry/unified-workers:local
HANDOFF_ENABLE_POLARS=true

# Autoscale prerequisite for a NEW isolated Kafka project only. Existing Raw topics
# are never repartitioned by the launcher; changing this later fails preflight.
# Multi-replica normalizer also needs container identity and separate acceptance.
HANDOFF_RAW_PARTITIONS=1
HANDOFF_NORMALIZER_ID_MODE=explicit

# Swarm candidate configuration for runtime/swarm.mjs.
# Use a NEW isolated stack name, distinct from HANDOFF_PROJECT. PARALLEL_LIVE
# requires a fresh DB/Kafka/cursor and a separately reviewed feed lineage.
SWARM_STACK_NAME=
SWARM_MIGRATION_MODE=OFFLINE_DEMO
SWARM_LIVE_ACK=
SWARM_CONNECTOR_ID=
SWARM_FEED_URL=
SWARM_FEED_ID=
SWARM_INITIAL_AFTER_SEQ=
# For a NEW isolated stack only: set HANDOFF_RAW_PARTITIONS=2 and this to
# container before the first deploy to permit two Normalizer replicas.
# Existing Kafka topics are never repartitioned. Leave explicit for 1 partition.
SWARM_NORMALIZER_ID_MODE=explicit
# Experimental transaction microbatch size (1..256); benchmark before live use.
SWARM_NORMALIZER_TRANSACTION_BATCH_SIZE=64
SWARM_CATALOG_URL=
SWARM_DASHSCOPE_BASE_URL=
SWARM_MONITORING_ENABLED=false
SWARM_API_IMAGE=
SWARM_WEB_IMAGE=
SWARM_WORKERS_IMAGE=
# Optional scoped rollout: leave blank to share SWARM_WORKERS_IMAGE.
SWARM_NORMALIZER_IMAGE=
SWARM_POSTGRES_IMAGE=
SWARM_KAFKA_IMAGE=
SWARM_TRAEFIK_IMAGE=
# HTTPS application layer: `local` uses a trusted certificate; `acme` uses
# public DNS + TCP 80/443 on the labelled edge node for Let's Encrypt.
SWARM_TLS_MODE=local
SWARM_PUBLIC_DOMAIN=funnelmetry.local
SWARM_ACME_EMAIL=
# Set only after public DNS and inbound TCP 80/443 have been verified on edge.
SWARM_ACME_READY_ACK=
# Absolute certificate/key paths OUTSIDE this repository, used only by
# `create-tls-secrets` for local mode; file contents become Swarm secrets.
SWARM_LOCAL_TLS_CERT_FILE=
SWARM_LOCAL_TLS_KEY_FILE=
SWARM_ADMIN_EMAIL=
# Optional overrides for secret creation; if blank, the launcher generates
# fresh random values. Admin password is saved in ignored runtime/credentials/.
# Never share the real env file or generated credential.
SWARM_DB_PASSWORD=
# Used only by `create-app-secrets`; keep independent of the old Compose runtime.
SWARM_JWT_SECRET=
SWARM_ADMIN_PASSWORD=

# Fresh installation: generate independent random secrets; never commit this file.
HANDOFF_DB_PASSWORD=
HANDOFF_JWT_SECRET=
HANDOFF_ADMIN_EMAIL=admin@unified.local
HANDOFF_ADMIN_PASSWORD=

# Optional live profile: only on a fresh, isolated PARALLEL_LIVE environment
# after DEC-125 feed-lineage/retention/cursor review. Do not reset stored cursor.
HANDOFF_LIVE_ACK=
HANDOFF_CONNECTOR_ID=
HANDOFF_FEED_URL=
HANDOFF_FEED_TOKEN=
HANDOFF_FEED_ID=
HANDOFF_INITIAL_AFTER_SEQ=

# Optional catalog profile: a separate Medusa Admin read credential.
HANDOFF_CATALOG_URL=
HANDOFF_CATALOG_KEY=

# Optional server-side Qwen. Set true only with an approved key/budget.
HANDOFF_ENABLE_QWEN=false
HANDOFF_DASHSCOPE_API_KEY=
HANDOFF_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional monitoring profile additionally needs runtime/monitoring/ secret files.
HANDOFF_MONITORING_ENABLED=false
MONITORING_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
MONITORING_GRAFANA_IMAGE=grafana/grafana:13.2.2@sha256:ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0
MONITORING_GRAFANA_PORT=5182
MONITORING_EXPIRY_WARNING_SECONDS=86400
MONITORING_SCRAPE_STALE_SECONDS=120

# Per-replica experimental ceilings; not autoscaling or host capacity guarantees.
HANDOFF_NORMALIZER_CPUS=1.0
HANDOFF_NORMALIZER_MEMORY=512m
HANDOFF_NORMALIZER_PIDS=128
HANDOFF_LEDGER_CPUS=1.0
HANDOFF_LEDGER_MEMORY=512m
HANDOFF_LEDGER_PIDS=128
HANDOFF_TELEMETRY_CPUS=1.0
HANDOFF_TELEMETRY_MEMORY=512m
HANDOFF_TELEMETRY_PIDS=128
HANDOFF_TRAFFIC_CPUS=1.0
HANDOFF_TRAFFIC_MEMORY=512m
HANDOFF_TRAFFIC_PIDS=128
HANDOFF_JOURNEY_CPUS=1.0
HANDOFF_JOURNEY_MEMORY=512m
HANDOFF_JOURNEY_PIDS=128
HANDOFF_FUNNEL_CPUS=1.0
HANDOFF_FUNNEL_MEMORY=512m
HANDOFF_FUNNEL_PIDS=128
HANDOFF_MATURITY_CPUS=1.0
HANDOFF_MATURITY_MEMORY=512m
HANDOFF_MATURITY_PIDS=128
HANDOFF_KPI_CPUS=1.0
HANDOFF_KPI_MEMORY=512m
HANDOFF_KPI_PIDS=128
HANDOFF_PUBLISHER_CPUS=1.0
HANDOFF_PUBLISHER_MEMORY=512m
HANDOFF_PUBLISHER_PIDS=128
