# Copy to runtime/qwen.env (ignored). Do not paste keys into chat.
# Used by POST /api/v2/chat when loaded into dashboard-api; legacy Chat does not consume it.
DASHBOARD_ENABLE_QWEN=false
# Only after staged product asset/catalog installation and isolated SQL acceptance.
DASHBOARD_ENABLE_PRODUCT_RANKING_STAGING=false
# Per-account requests per minute, shared by chat and structured order summary (1..120).
DASHBOARD_CHAT_REQUESTS_PER_MINUTE=20
# Requires Dashboard API runtime with python3 + Polars; not the plain Node image.
DASHBOARD_ENABLE_POLARS=false
DASHSCOPE_API_KEY=
# Use the exact Singapore endpoint shown in your Model Studio workspace.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TIMEOUT_MS=15000
