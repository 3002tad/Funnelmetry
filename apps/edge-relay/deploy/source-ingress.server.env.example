# Copy to source-ingress.server.env on the Source host, replace placeholders,
# then chmod 600. Do not commit this runtime file.
SOURCE_INGRESS_HOST=0.0.0.0
SOURCE_INGRESS_PORT=32000
SOURCE_INGRESS_DATABASE_PATH=/var/lib/funnelmetry-source-event-log/source-event-log.sqlite
SOURCE_INGRESS_BROWSER_KEYS_JSON={"medusa-reference-source":{"source_id":"medusa-reference","secret":"replace-with-browser-write-key","allowed_origins":["https://shop-test.entidi.io.vn"]}}
SOURCE_INGRESS_BACKEND_KEYS_JSON={"medusa-reference-source":{"source_id":"medusa-reference","secret":"replace-with-backend-hmac-key"}}
# This credential belongs only to the Pipeline Source Connector. It must not be
# embedded in Medusa, browser code, URLs, logs, or Cloudflare public config.
SOURCE_INGRESS_EVENT_FEED_TOKENS_JSON={"pipeline-connector":"replace-with-long-random-read-token"}
SOURCE_INGRESS_MAX_EVENT_LOG_EVENTS=100000
SOURCE_INGRESS_MAX_EVENT_LOG_BYTES=1073741824
SOURCE_INGRESS_MIN_FREE_DISK_BYTES=268435456
SOURCE_INGRESS_MAX_CLOCK_SKEW_MS=300000
SOURCE_INGRESS_EVENT_FEED_MAX_LIMIT=100
SOURCE_INGRESS_EVENT_FEED_MAX_WAIT_SECONDS=25
SOURCE_INGRESS_ADMIN_TOKEN=replace-with-random-admin-token
