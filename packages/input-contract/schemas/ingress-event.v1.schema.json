{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funnelmetry.io/schemas/ingress-event.v1.schema.json",
  "title": "Funnelmetry IngressEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "source_id", "event_id", "source_event_type", "source_schema_version", "producer", "source_payload"],
  "properties": {
    "specversion": { "const": "ingress-event.v1" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$" },
    "event_id": { "type": "string", "minLength": 3, "maxLength": 192 },
    "source_event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_schema_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "produced_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "enum": ["browser_sdk", "source_bridge"] },
    "anonymous_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "source_payload": { "type": "object" },
    "source_metadata": { "type": "object" }
  }
}
