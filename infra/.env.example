# Shared local environment for the active V2 applications.
# Copy this file to infra/.env and replace development credentials as needed.

# Input Gateway
INPUT_GATEWAY_HOST=0.0.0.0
INPUT_GATEWAY_PORT=31000
INPUT_GATEWAY_INSTANCE_ID=gateway-1
INPUT_GATEWAY_COORDINATION_MODE=postgres
INPUT_GATEWAY_DATABASE_URL=postgresql://app:change-me@localhost:5432/realtime
INPUT_GATEWAY_CLAIM_LEASE_MS=30000
INPUT_GATEWAY_CORS_ORIGINS=http://localhost:8000
INPUT_GATEWAY_BROWSER_KEYS_JSON={"browser-dev":{"source_id":"medusa-reference","secret":"change-me"}}
INPUT_GATEWAY_BACKEND_KEYS_JSON={"bridge-dev":{"source_id":"medusa-reference","secret":"change-me"}}
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=funnelmetry.raw.v1
KAFKA_TOPIC_INGRESS_RECEIPTS=funnelmetry.ingress.receipts.v1
KAFKA_TOPIC_CANONICAL=funnelmetry.canonical.v1
KAFKA_TOPIC_CANONICALIZATION_OUTCOMES=funnelmetry.canonicalization.outcomes.v1
KAFKA_TOPIC_QUARANTINE=funnelmetry.quarantine.v1
KAFKA_TOPIC_CANONICAL_PERSISTED=funnelmetry.canonical.persisted.v1
KAFKA_TOPIC_JOURNEY_RESOLVED=funnelmetry.journey.resolved.v1
KAFKA_TOPIC_FUNNEL_UPDATED=funnelmetry.funnel.updated.v1
KAFKA_TOPIC_KPI_UPDATED=funnelmetry.kpi.updated.v1

# Edge Relay (browser public ingress; upstream may stay disabled until Tailscale is ready)
RELAY_HOST=0.0.0.0
RELAY_PORT=32000
RELAY_INSTANCE_ID=edge-relay-1
RELAY_DATABASE_PATH=./data/funnelmetry-edge-relay.sqlite
RELAY_BROWSER_KEYS_JSON={"relay-browser":{"source_id":"medusa-reference","secret":"change-me","allowed_origins":["http://localhost:8000"]}}
RELAY_UPSTREAM_ENABLED=false
RELAY_UPSTREAM_INGRESS_URL=
RELAY_UPSTREAM_BROWSER_KEYS_JSON={}
RELAY_MAX_SPOOL_EVENTS=100000
RELAY_MAX_SPOOL_BYTES=1073741824
RELAY_MIN_FREE_DISK_BYTES=268435456
RELAY_DELIVERY_LEASE_MS=30000
RELAY_DELIVERY_INTERVAL_MS=1000
RELAY_DELIVERY_BATCH_SIZE=20
RELAY_RETRY_MIN_MS=1000
RELAY_RETRY_MAX_MS=60000
RELAY_UPSTREAM_REQUEST_TIMEOUT_MS=3000

# Canonical Normalizer
CANONICAL_NORMALIZER_INSTANCE_ID=normalizer-1
CANONICAL_NORMALIZER_CONSUMER_GROUP_ID=funnelmetry-canonical-normalizer-v1
# Optional versioned source-native mapping artifact. Keep empty for canonical passthrough only.
CANONICAL_NORMALIZER_MAPPING_CONFIG_PATH=../../integrations/medusa/canonical-mappings.v1.json

# Ingress Telemetry Writer
INGRESS_TELEMETRY_INSTANCE_ID=telemetry-1
INGRESS_TELEMETRY_CONSUMER_GROUP_ID=funnelmetry-ingress-telemetry-v1
INGRESS_TELEMETRY_POSTGRES_POOL_SIZE=5

# Canonical Ledger Writer
CANONICAL_LEDGER_INSTANCE_ID=ledger-1
CANONICAL_LEDGER_CONSUMER_GROUP_ID=funnelmetry-canonical-ledger-v1
CANONICAL_LEDGER_POSTGRES_POOL_SIZE=5

# Journey Processor
JOURNEY_PROCESSOR_INSTANCE_ID=journey-1
JOURNEY_PROCESSOR_CONSUMER_GROUP_ID=funnelmetry-journey-processor-v1
JOURNEY_PROCESSOR_POSTGRES_POOL_SIZE=5

# Funnel Processor
FUNNEL_PROCESSOR_INSTANCE_ID=funnel-1
FUNNEL_PROCESSOR_CONSUMER_GROUP_ID=funnelmetry-funnel-processor-v1
FUNNEL_PROCESSOR_POSTGRES_POOL_SIZE=5
FUNNEL_PROFILE_SOURCE_ID=medusa-reference

# Funnel Maturity Scheduler
MATURITY_SCHEDULER_INSTANCE_ID=maturity-1
MATURITY_SCHEDULER_POLL_INTERVAL_MS=5000
MATURITY_SCHEDULER_BATCH_SIZE=100
MATURITY_SCHEDULER_POSTGRES_POOL_SIZE=3
MATURITY_SCHEDULER_FINALIZATION_ENABLED=true

# KPI Projector
KPI_PROJECTOR_INSTANCE_ID=kpi-1
KPI_PROJECTOR_CONSUMER_GROUP_ID=funnelmetry-kpi-projector-v1
KPI_PROJECTOR_POSTGRES_POOL_SIZE=5

# Dashboard API
PORT=32000
CORS_ORIGIN_DASHBOARD=http://localhost:5180
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES=7d
DASHBOARD_ADMIN_EMAIL=admin@gmail.com
DASHBOARD_ADMIN_PASSWORD=change-me

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=realtime
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Pipeline dependencies retained while the V2 backend is being migrated
PIPELINE_TRACKING_API_URL=http://127.0.0.1:31000
PIPELINE_COMMERCE_BACKEND_URL=http://127.0.0.1:30330
PIPELINE_RABBITMQ_MGMT_URL=http://127.0.0.1:15672
RABBITMQ_MGMT_USER=app
RABBITMQ_MGMT_PASS=app

# Insights dependencies
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pipeline_insights
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=55000
OLLAMA_TEMPERATURE=0.65
OLLAMA_NUM_PREDICT=900
CHAT_LLM_PLANNER=true
CHAT_PLANNER_TIMEOUT_MS=12000
CHAT_POLISH_TEMPERATURE=0.75
CHAT_POLISH_NUM_PREDICT=1024
