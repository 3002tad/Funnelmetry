# Một file env cho pipeline (k3s secret, build dashboard, chạy local services).
# Copy: cp infra/.env.example infra/.env
# Runtime: docs/RUNTIME.md · Ports: infra/PORTS.md

# --- Host / UI build (Laptop 2 trỏ về Lap1) ---
WSL_IP=172.29.248.123
VITE_TRACKING_API_URL=http://172.29.248.123:31000
VITE_DASHBOARD_API_URL=http://172.29.248.123:32000

# --- Postgres (k3s secret + dashboard-api local) ---
POSTGRES_DB=realtime
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Dashboard API (local; k8s deployment sets PORT=3000 in-cluster) ---
DASHBOARD_API_PORT=32000
CORS_ORIGIN_DASHBOARD=http://localhost:5174,http://localhost:30809
JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRES=7d
DASHBOARD_ADMIN_EMAIL=admin@gmail.com
DASHBOARD_ADMIN_PASSWORD=admin@123
PIPELINE_TRACKING_API_URL=http://127.0.0.1:31000
PIPELINE_COMMERCE_BACKEND_URL=http://127.0.0.1:30330

# --- Tracking API (local: PORT=3000; k3s deployment sets PORT=3000) ---
# PORT=3000
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=tracking_events_raw
CORS_ORIGIN=http://localhost:5173,http://localhost:30809
ENABLE_BUSINESS_EVENT_INGEST=true
TRACKING_INGEST_API_KEY=demo-ingest-key-change-me

# --- RabbitMQ (k3s: rabbitmq:5672; local/port-forward: localhost hoặc WSL_IP) ---
RABBITMQ_URL=amqp://app:app@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events
RABBITMQ_EXCHANGE_TYPE=topic

# Commerce-backend (k3s NodePort 30330; deployment PORT=3000)
# PORT=3000

# Web-demo-worker (k3s)
RABBITMQ_ORDER_QUEUE=webdemo.order-processing
RABBITMQ_ORDER_BINDING_KEY=order.created
WORKER_STEP_DELAY_MS=600

# --- Streaming / chat (k3s) ---
FLUSH_INTERVAL_SEC=30
EVENT_BATCH_SIZE=100
QDRANT_COLLECTION=pipeline_insights
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_TEMPERATURE=0.65
OLLAMA_NUM_PREDICT=768
