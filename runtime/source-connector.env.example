# Copy to ignored runtime/source-connector.env. Never put real tokens in Git.
# NORMAL only for the original Kafka cluster, NOT after restore/recreated Kafka.
SOURCE_CONNECTOR_MODE=NORMAL
SOURCE_CONNECTOR_ID=medusa-source
SOURCE_EVENT_FEED_URL=https://source.example/v1/events
SOURCE_EVENT_FEED_TOKEN=
SOURCE_EVENT_FEED_ID=
# Explicitly approve replay from 0; do not silently discard existing source events.
SOURCE_INITIAL_AFTER_SEQ=0
SOURCE_CONNECTOR_DATABASE_URL=postgresql://funnelmetry:funnelmetry-local@postgres:5432/funnelmetry
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SOURCE_FEED_WAIT_SECONDS=25
SOURCE_FEED_TIMEOUT_MS=35000
SOURCE_FEED_BATCH_SIZE=100
SOURCE_CONNECTOR_HEALTH_PORT=32100
