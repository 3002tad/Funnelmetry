FROM node:22-bookworm-slim
WORKDIR /workspace/workers/reference-order-cdc-v2-mapper
COPY workers/reference-order-cdc-v2-mapper/package.json workers/reference-order-cdc-v2-mapper/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY workers/reference-order-cdc-v2-mapper/src ./src
COPY workers/shared/postgres-config.mjs /workspace/workers/shared/postgres-config.mjs
USER node
CMD ["node", "src/main.js"]
