FROM node:22-bookworm-slim
WORKDIR /workspace/workers/catalog-cdc-writer
COPY workers/catalog-cdc-writer/package.json workers/catalog-cdc-writer/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY workers/catalog-cdc-writer/src ./src
COPY workers/shared/postgres-config.mjs /workspace/workers/shared/postgres-config.mjs
USER node
CMD ["node", "src/main.js"]
