# Apply these to the Dashboard API service environment explicitly.
# This is documentation, not an automatically loaded env file.
# Read-only probes do not activate scale/recovery actuators.
DASHBOARD_KAFKA_LAG_ENABLED=false
DASHBOARD_KAFKA_LAG_BROKERS=kafka:9092
DASHBOARD_KAFKA_LAG_TARGETS_JSON=[{"group_id":"funnelmetry-canonical-normalizer-v1","topic":"funnelmetry.raw.v1"},{"group_id":"funnelmetry-canonical-ledger-v1","topic":"funnelmetry.canonical.v1"},{"group_id":"funnelmetry-ingress-telemetry-v1","topic":"funnelmetry.ingress.receipts.v1"},{"group_id":"funnelmetry-ingress-telemetry-v1","topic":"funnelmetry.canonicalization.outcomes.v1"},{"group_id":"funnelmetry-traffic-source-raw-v1","topic":"funnelmetry.raw.v1"},{"group_id":"funnelmetry-journey-processor-v1","topic":"funnelmetry.canonical.persisted.v1"},{"group_id":"funnelmetry-funnel-processor-v1","topic":"funnelmetry.journey.resolved.v1"},{"group_id":"funnelmetry-kpi-projector-v1","topic":"funnelmetry.funnel.updated.v1"}]
DASHBOARD_WORKER_HEALTH_ENABLED=true
DASHBOARD_CONNECTOR_READINESS_URL=http://source-connector:32100/readyz
# Optional: mount collector output read-only into the API container and set
# the path visible inside that container. The API needs no Docker socket.
DASHBOARD_SCALING_SNAPSHOT_FILE=
DASHBOARD_SCALING_STACK=funnelmetry_vps_live
DASHBOARD_SCALING_GROUP_ID=funnelmetry-canonical-normalizer-v1
DASHBOARD_SCALING_TOPIC=funnelmetry.raw.v1
DASHBOARD_TELEMETRY_RETENTION_DAYS=7
# Optional completed OBSERVE_ONLY evidence directory; never an actuator switch.
DASHBOARD_CONTROLLER_OBSERVATION_DIR=
