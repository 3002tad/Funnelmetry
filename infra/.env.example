# Copy to infra/.env — required for docker compose

POSTGRES_DB=realtime
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

TRACKING_API_PORT=3100
DEMO_SHOP_PORT=8080
DASHBOARD_API_PORT=3200
DASHBOARD_UI_PORT=8090

# Browser on host calls APIs (not Docker internal hostnames)
VITE_TRACKING_API_URL=http://localhost:3100
VITE_DASHBOARD_API_URL=http://localhost:3200

CORS_ORIGIN=http://localhost:5173,http://localhost:8080
CORS_ORIGIN_DASHBOARD=http://localhost:5174,http://localhost:8090

FLUSH_INTERVAL_SEC=30

JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRES=7d
# Quote values containing @ — otherwise compose may truncate at @
DASHBOARD_ADMIN_EMAIL="admin@pipeline.local"
DASHBOARD_ADMIN_PASSWORD="admin123"

# Phase 6 — Qdrant insights for chatbot RAG (internal; do not expose on tailnet)
QDRANT_PORT=6333
QDRANT_COLLECTION=pipeline_insights

# Phase 6 — Ollama (LLM local, chạy trên Windows host)
# Sau khi cài Ollama + pull qwen2.5:3b, bỏ comment dòng dưới
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
