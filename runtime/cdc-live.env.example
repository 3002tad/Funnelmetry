# Copy to ignored runtime/cdc-live.env on the operator host. Reuse the exact
# CDC-11 identity values; change only stack name, image pin and mapper volume.
CDC_STACK_NAME=funnelmetry_cdc
CDC_WORKERS_IMAGE=ghcr.io/3002tad/funnelmetry-cdc-workers@sha256:<reviewed-digest>
CDC_CART_EPOCH=cdc_cart_epoch1
CDC_CART_TOPIC_PREFIX=cdc_medusa_cart_line_item_v1
CDC_CART_GROUP_ID=medusa-cart-line-item-cdc-v1
CDC_CANONICAL_TOPIC=funnelmetry.canonical.v1
CDC_CONNECT_IMAGE=quay.io/debezium/connect@sha256:<reviewed-digest>
CDC_POSTGRES_IMAGE=postgres@sha256:<reviewed-digest>
CDC_SOURCE_ID=medusa-reference
CDC_ORDER_EPOCH=cdc11_order_epoch1
CDC_PREVIOUS_ORDER_EPOCH=pre_cdc_unobserved
CDC_CATALOG_EPOCH=cdc11_catalog_epoch1
CDC_INVENTORY_PRICE_EPOCH=cdc11_inventory_price_epoch1
CDC_ORDER_TOPIC_PREFIX=cdc_shadow_medusa_order_v2_e1
CDC_ORDER_FACT_TOPIC=cdc_shadow_reference.order_recorded_state.v2
CDC_CATALOG_TOPIC_PREFIX=cdc_shadow_medusa_catalog
CDC_INVENTORY_PRICE_TOPIC_PREFIX=cdc_shadow_medusa_inventory_price_v2
CDC_CONNECT_GROUP_ID=cdc11_connect_epoch1
CDC_CONNECT_CONFIG_TOPIC=cdc11_connect_configs_e1
CDC_CONNECT_OFFSET_TOPIC=cdc11_connect_offsets_e1
CDC_CONNECT_STATUS_TOPIC=cdc11_connect_status_e1
CDC_CATALOG_GROUP_ID=cdc11_catalog_writer_e1
CDC_INVENTORY_PRICE_GROUP_ID=cdc11_inventory_writer_e1
CDC_ORDER_MAPPER_GROUP_ID=cdc11_order_mapper_e1
CDC_ORDER_SINK_GROUP_ID=cdc11_order_sink_e1
CDC_PIPELINE_DB_PASSWORD_SECRET=funnelmetry_vps_live_db_password_v1
CDC_MAPPER_DB_PASSWORD_SECRET=funnelmetry_cdc_target_shadow_mapper_db_password_v1
CDC_PIPELINE_DATA_NETWORK=funnelmetry_vps_live_data
CDC_SOURCE_NETWORK=funnelmetry_cdc_source
CDC_MAPPER_DATA_VOLUME=funnelmetry_cdc_target_shadow_order-mapper-data
