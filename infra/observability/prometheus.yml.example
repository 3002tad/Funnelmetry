# Provide a metrics-only machine credential through a secret file.
# Internal Compose network; do not publish dashboard-api for scraping.
global:
  scrape_interval: 30s
scrape_configs:
  - job_name: funnelmetry-monitoring
    metrics_path: /api/monitoring/metrics
    scrape_timeout: 12s
    authorization:
      type: Bearer
      credentials_file: /run/secrets/funnelmetry_metrics_token
    static_configs:
      - targets: [dashboard-api:32000]
