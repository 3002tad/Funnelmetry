# Copy to edge-relay.server.env on Ubuntu, replace placeholders, then chmod 600.
# Do not commit the runtime file or put these values in a browser bundle.
RELAY_HOST=0.0.0.0
RELAY_PORT=32000
RELAY_INSTANCE_ID=edge-relay-ubuntu-1
RELAY_DATABASE_PATH=/var/lib/funnelmetry-relay/relay.sqlite
RELAY_BROWSER_KEYS_JSON={"medusa-reference-relay":{"source_id":"medusa-reference","secret":"replace-with-random-browser-write-key","allowed_origins":["https://shop-test.entidi.io.vn"]}}
RELAY_UPSTREAM_ENABLED=false
RELAY_UPSTREAM_INGRESS_URL=
RELAY_UPSTREAM_BROWSER_KEYS_JSON={}
RELAY_MAX_SPOOL_EVENTS=100000
RELAY_MAX_SPOOL_BYTES=1073741824
RELAY_MIN_FREE_DISK_BYTES=268435456
RELAY_DELIVERY_LEASE_MS=30000
RELAY_DELIVERY_INTERVAL_MS=1000
RELAY_DELIVERY_BATCH_SIZE=20
RELAY_RETRY_MIN_MS=1000
RELAY_RETRY_MAX_MS=60000
RELAY_UPSTREAM_REQUEST_TIMEOUT_MS=3000
RELAY_ADMIN_TOKEN=replace-with-random-admin-token
