# ============================================================================
# INFRASTRUCTURE ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — never commit it.
# Docker Compose auto-loads `infra/.env` when running `docker compose up`.

# ---- PostgreSQL ----
POSTGRES_DB=realtime
POSTGRES_USER=app
POSTGRES_PASSWORD=CongNgheMoi

# ---- Dashboard API (JWT auth) ----
# REQUIRED in production. Generate a strong random string:
#   openssl rand -base64 48
JWT_SECRET=CongNgheMoi

# ---- Default seeded users (dashboard-api) ----
# These are seeded on startup so you can log in. Change in production.
ADMIN_PASSWORD=admin123
VIEWER_PASSWORD=viewer123

# ---- Cache ----
CACHE_TTL_MS=3000
