# One ignored env per isolated Swarm deployment. Copy to runtime/deploy.env.
# Follow docs/SWARM_MIGRATION.md. Never share this real file or reuse another
# machine's volumes, cursor, certificate private key, or secrets.
# Old HANDOFF_* keys in existing local env files are read only for compatibility.
SWARM_STACK_NAME=
SWARM_MIGRATION_MODE=OFFLINE_DEMO
SWARM_LIVE_ACK=
SWARM_CONNECTOR_ID=
SWARM_FEED_URL=
SWARM_FEED_ID=
SWARM_INITIAL_AFTER_SEQ=
# For a NEW isolated stack only. Never repartition an existing Kafka topic.
# Set 2 and SWARM_NORMALIZER_ID_MODE=container before first deploy for 2 replicas.
SWARM_RAW_PARTITIONS=1
SWARM_NORMALIZER_ID_MODE=explicit
# Experimental transaction microbatch size (1..256); benchmark before live use.
SWARM_NORMALIZER_TRANSACTION_BATCH_SIZE=64

# Optional, bounded live autoscale acceptance bot. These are Source Ingress
# write credentials, NOT SWARM_FEED_URL/token. Keep real values only in ignored
# runtime/deploy.env; never commit or paste the Browser Write Key into chat.
FUNNELMETRY_SOURCE_INGRESS_URL=
FUNNELMETRY_SOURCE_ID=medusa-reference
FUNNELMETRY_SOURCE_KEY_ID=
FUNNELMETRY_BROWSER_WRITE_KEY=
SWARM_LIVE_LOAD_ACK=

# Separate read-only Source Feed, Medusa catalog and Qwen credentials. The
# launcher creates isolated Docker secrets; these values never enter stack YAML.
SWARM_FEED_TOKEN=
SWARM_CATALOG_KEY=
SWARM_DASHSCOPE_API_KEY=
SWARM_CATALOG_URL=
# CDC-12 catalog canary only: activate a quality-gated CDC binding first, then
# set catalog_cdc and redeploy. Keep admin_api for immediate rollback.
SWARM_PRODUCT_REFERENCE_PROVIDER=admin_api
# Set to 0 only for an active catalog_cdc canary with a fresh quality lease.
# Set back to 1 when rolling the catalog read path back to admin_api.
SWARM_CATALOG_SYNC_REPLICAS=1
# Reference current-offer endpoint stays off until the stage-2 read path is
# reviewed and deployed with a fresh, reconciled 16-table quality lease.
SWARM_ENABLE_CDC_REFERENCE_OFFER=false
# CDC order-v2 reference current-state read path only. This does not publish
# a funnel profile or replace the live order.placed terminal. Set all three
# scope values to the reviewed target epoch before enabling on PARALLEL_LIVE.
SWARM_ENABLE_CDC_REFERENCE_CANDIDATE=false
# Official reference current-state route requires a published ACTIVE profile
# binding in PostgreSQL. Keep false through shadow verification and rollback.
SWARM_ENABLE_CDC_REFERENCE_ACTIVE=false
SWARM_CDC_REFERENCE_SOURCE_ID=
SWARM_CDC_REFERENCE_COVERAGE_EPOCH_ID=
SWARM_CDC_REFERENCE_ACTIVATION_AT=
SWARM_DASHSCOPE_BASE_URL=
SWARM_MONITORING_ENABLED=false
# Optional Qdrant index of versioned analytical metadata for Chat V2 definitions.
# Requires a reviewed pinned image and enough stateful-node capacity. No raw
# events or authoritative metrics are stored here.
SWARM_VECTOR_KNOWLEDGE_ENABLED=false
SWARM_QDRANT_IMAGE=qdrant/qdrant:v1.15.5@sha256:0fb8897412abc81d1c0430a899b9a81eb8328aa634e7242d1bc804c1fe8fe863
# Immutable linux/amd64 release set verified in GHCR on 2026-10-15.
# Both independent machines may use these exact refs; review a new release
# together before changing any digest. This is not proof of runtime health.
SWARM_API_IMAGE=ghcr.io/3002tad/funnelmetry/handoff-api@sha256:864b9d4ff3b175bbcf76145910b460795ac5bfa68fbdfa847380288ba89bb684
SWARM_WEB_IMAGE=ghcr.io/3002tad/funnelmetry/handoff-web@sha256:4f5be28249e3f3e94445b8695d679f8bf46540f2486a6a8fb38a47f744dfd31f
SWARM_WORKERS_IMAGE=ghcr.io/3002tad/funnelmetry/handoff-workers@sha256:a23a7597192c16367ac0627390acbc6a18a210bca0ef9ddad3556fd1cfaec93a
# Pin these separately for a CDC profile cutover; both must understand
# disabled_at so a publisher restart cannot reactivate retired profiles.
# Empty values inherit SWARM_WORKERS_IMAGE for older deployments.
SWARM_PROFILE_PUBLISHER_IMAGE=
SWARM_FUNNEL_PROCESSOR_IMAGE=
# Scoped normalizer rollout used by the current live stack; do not clear it
# merely to match the generic workers image without a reviewed rollback.
SWARM_NORMALIZER_IMAGE=ghcr.io/3002tad/funnelmetry/handoff-workers@sha256:f61aa962eae67c8133c26d29bba68567abf001836b8d2bc19e48c4e691c901b9
SWARM_POSTGRES_IMAGE=postgres:15-alpine@sha256:f7d23353e1b15400d22ebe31189f4d314b87a4c129cc400c8c2d8d4ca127bf81
SWARM_KAFKA_IMAGE=apache/kafka:3.9.1@sha256:4ceccc577f03f51f6af8dbfda55194d0d892f4fa7913ffbded567ce3895622ed
SWARM_TRAEFIK_IMAGE=traefik:v3.6.0@sha256:18112aed2bfe3dfb8534f1045622390c3316596cff0cefab64f44e43d23e1640
# Public HTTPS application layer: `local` uses a trusted certificate; `acme`
# uses public DNS + TCP 80/443; `tunnel` uses an HTTP origin restricted to the
# Cloudflare connector on the host. Never expose the tunnel origin to the Internet.
SWARM_TLS_MODE=local
SWARM_PUBLIC_DOMAIN=funnelmetry.local
SWARM_TUNNEL_ORIGIN_PORT=31080
# Set only after proving the published tunnel origin port is blocked externally.
SWARM_TUNNEL_ORIGIN_RESTRICTED_ACK=
SWARM_ACME_EMAIL=
# Set only after public DNS and inbound TCP 80/443 have been verified on edge.
SWARM_ACME_READY_ACK=
# Absolute certificate/key paths OUTSIDE this repository, used only by
# `create-tls-secrets` for local mode; file contents become Swarm secrets.
SWARM_LOCAL_TLS_CERT_FILE=
SWARM_LOCAL_TLS_KEY_FILE=
SWARM_ADMIN_EMAIL=
# Optional overrides for secret creation; if blank, the launcher generates
# fresh random values. Admin password is saved in ignored runtime/credentials/.
# Never share the real env file or generated credential.
SWARM_DB_PASSWORD=
# Used only by `create-app-secrets`; do not share between deployments.
SWARM_JWT_SECRET=
SWARM_ADMIN_PASSWORD=

# Optional monitoring uses the same Swarm stack and separate credentials.
MONITORING_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
MONITORING_GRAFANA_IMAGE=grafana/grafana:13.2.2@sha256:ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0
